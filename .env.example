# Copy to .env. Never commit .env.
#
# DEV_MODE=true lets the placeholder secrets below work. That's only safe because docker-compose.yml
# binds every port to 127.0.0.1. To expose anything beyond your machine, set DEV_MODE=false and
# replace every secret, e.g.:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DEV_MODE=true

# --- secrets -----------------------------------------------------------------
# Shared HS256 key: the agent signs user JWTs, the MCP server and Cube verify them.
JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes
CHAINLIT_AUTH_SECRET=change-me-chainlit-session-secret-32-bytes
APP_OWNER_PASSWORD=app_owner_pw
MCP_READER_PASSWORD=mcp_reader_pw
CUBE_READER_PASSWORD=cube_reader_pw
AUDIT_WRITER_PASSWORD=audit_writer_pw

# --- model -------------------------------------------------------------------
# Any Ollama model with tool support. Try a bigger one (e.g. qwen3:8b) and compare with the eval suite.
MODEL_NAME=gemma4:e2b
MODEL_REASONING=true

# --- behavior ----------------------------------------------------------------
REQUIRE_SQL_APPROVAL=true
LLM_INPUT_GUARD=false
MAX_AGENT_STEPS=8

# --- host ports (change if something already uses them) ---------------------
PG_PORT=5432

# --- for running code on the host (tests, evals) against the compose stack ---
PG_ADMIN_DSN=postgresql://app_owner:app_owner_pw@localhost:5432/retail
PG_READER_DSN=postgresql://mcp_reader:mcp_reader_pw@localhost:5432/retail
PG_AUDIT_DSN=postgresql://audit_writer:audit_writer_pw@localhost:5432/retail
PG_CHECKPOINT_DSN=postgresql://app_owner:app_owner_pw@localhost:5432/agent_state
CUBE_URL=http://localhost:4000/cubejs-api/v1
MCP_URL=http://localhost:8001/mcp
OLLAMA_URL=http://localhost:11434
